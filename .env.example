# docker compose 가 읽는 설정. 이 파일을 복사해 .env 로 만들고 값을 바꿔 주세요.
#   Windows:  copy .env.example .env
# .env 는 .gitignore 에 있어서 GitHub 에 올라가지 않아요. (비밀번호를 커밋하지 마세요)

DB_USER=qrcheckin
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# 32자 이상 아무 문자열. 바꾸면 기존 로그인은 풀려요(다시 로그인)
JWT_SECRET=change-me-jwt-secret-0123456789abcdef-0123
QR_SECRET=change-me-qr-secret-0123456789abcdef-01234
